# =============================================================================
# UNINOTAS - APACHE REWRITE CONFIGURATION (DIRECTORIO PUBLIC)
# Enruta todas las peticiones dinámicas a index.php pasando la ruta por $_GET['url']
# =============================================================================

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Si la petición NO es un archivo existente ni un directorio existente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir a public/index.php con parámetro url
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
