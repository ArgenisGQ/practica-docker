# =============================================================================
# UNINOTAS - APACHE REWRITE CONFIGURATION (RAÍZ APP)
# Redirige las solicitudes entrantes al Front Controller en public/index.php
# =============================================================================

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Si se accede directamente al directorio app, enruta a public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
