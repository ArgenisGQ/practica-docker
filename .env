# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA UNINOTAS
# ==============================================================================

# Entorno de Ejecución
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# ==============================================================================
# CONFIGURACIÓN DE MICROSOFT SQL SERVER 2022
# ==============================================================================
MSSQL_SA_PASSWORD=SuperSecretPass123!
MSSQL_PID=Developer
ACCEPT_EULA=Y

# Parámetros de Conexión PHP -> SQL Server
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=UniNotasDB

# Usuario Lectura/Escritura (Administrador en la App)
DB_USER_RW=uni_write
DB_PASSWORD_RW=WriteAll#2024

# Usuario Solo Lectura (Consultor en la App)
DB_USER_RO=uni_read
DB_PASSWORD_RO=ReadOnly#2024

# ==============================================================================
# CREDENCIALES DE APLICACIÓN (AUTENTICACIÓN WEB)
# Nota: En producción usar contraseñas hasheadas en BD (password_hash).
# Para esta demo técnica, se configuran cuentas fijas por rol.
# ==============================================================================
APP_ADMIN_USER=admin
APP_ADMIN_PASS=admin123

APP_VIEWER_USER=viewer
APP_VIEWER_PASS=viewer123
